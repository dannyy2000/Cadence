# Demo-recording instance — same CTA/CTB, same calibrated threshold/max-batch-size as the
# real production deployment, EXCEPT batchWindowBlocks=60 (~50-60 real seconds) instead of
# production's 10 (~8-10 seconds), so a human can actually click through two trades landing
# in the same batch on camera. See MILESTONES.md "Demo-recording instance" for why this
# exists and how it's verified.
#
# To use it locally for recording: cp .env.demo .env.local, then npm run dev.
# When you're done recording, restore the real one: cp .env.production .env.local
# (.env.local is gitignored, so there's no git history to check out from - these two files
# are the actual backup).
VITE_RPC_URL=https://sepolia.unichain.org
VITE_HOOK_ADDRESS=0x472859884dE0CC5991D9CFfbc1Fb9FDd7B678088
VITE_CURRENCY0=0x942300837ecb871b6b015a1d60adc89a156618ff
VITE_CURRENCY1=0x9deaf219a89fe8219712d8d6814f41b2d482a1e4
VITE_ROUTER_ADDRESS=0x9cD2b0a732dd5e023a5539921e0FD1c30E198Dba
VITE_POOL_FEE=3000
VITE_POOL_TICK_SPACING=60
VITE_POLL_INTERVAL_MS=3000
